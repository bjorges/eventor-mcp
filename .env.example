# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit real credentials.

# Base URL of the Eventor API. Norway shown below; Sweden uses eventor.orientering.se.
EVENTOR_BASE_URL=https://eventor.orientering.no/api/

# Club-specific API key (32 hex chars). Generate/rotate it in Eventor under
# Klubben -> Klubbinnstillinger. Used for read endpoints: events, organisations.
EVENTOR_API_KEY=

# Personal Eventor login. Required by endpoints that return competitor-level
# data or that write data: export/classes, export/entries, export/competitors,
# import/startlist, import/resultlist.
EVENTOR_USERNAME=
EVENTOR_PASSWORD=
